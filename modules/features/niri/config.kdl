// On top of niri's default config.

// The launcher sends physical key positions, so this matches the Mac's "Colemak DH ANSI".
input {
    keyboard {
        xkb {
            layout "us"
            variant "colemak_dh"
        }
    }
}

// Look after vic/vix, in the compline colours ghostty and nvim use.
layout {
    gaps 10
    focus-ring {
        width 3
        active-color "#d4ccb4"
        inactive-color "#3d424a"
        urgent-color "#cdacac"
    }
    border {
        off
    }
    insert-hint {
        color "#d4ccb480"
    }
    tab-indicator {
        active-color "#d4ccb4"
        inactive-color "#515761"
        urgent-color "#cdacac"
    }
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="^zen" title="^Picture-in-Picture$"
    open-floating true
}

overview {
    backdrop-color "#1a1d21"
}

// Frosted glass: blur (of the wallpaper, niri's cheap "xray" default) plus grain behind the
// semi-transparent terminal and bar. The focus ring isn't drawn behind ghostty, where it
// would tint it.
window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"
    draw-border-with-background false
    background-effect {
        blur true
        noise 0.1
    }
}

layer-rule {
    match namespace="^noctalia-bar"
    background-effect {
        blur true
        noise 0.1
    }
}

spawn-at-startup "ghostty"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    Mod+T hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
    Mod+D hotkey-overlay-title="Run an Application: Noctalia" { spawn-sh "noctalia msg panel-toggle launcher"; }
    // The Mac keyboard has no Print key.
    Mod+Shift+S hotkey-overlay-title="Take a Screenshot" { screenshot; }
}

// The VM pointer is absolute, so leaving the window pins it to the top-left hot corner.
gestures {
    hot-corners {
        off
    }
}
