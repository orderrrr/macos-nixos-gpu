+++ b/src/devices/src/virtio/balloon/reclaim.rs
@@ -0,0 +1,162 @@
+//! macOS: give the pages of a free page report back to the Mac.
+//!
+//! Guest RAM is one anonymous mapping that XNU backs with 128 MB VM objects, and hv_vm_map
+//! shares those objects with the hypervisor's map. madvise(MADV_FREE) on a range of a shared
+//! object frees nothing, and neither does replacing the range alone (MAP_FIXED): the old pages
+//! stay in the object, resident or compressed, until the whole object goes. So a reported
+//! range is moved aside (mach_vm_remap: a second mapping of the same pages, none touched),
+//! fresh demand-zero memory is mapped in its place and into the guest, and a worker thread
+//! advises the moved-aside range MADV_FREE_REUSABLE (macOS drops its compressed copies and
+//! takes its resident pages first) and unmaps it. The advice runs off the device thread: it
+//! costs about 0.1 ms per MB the Mac still holds.
+//!
+//! Design from OmacVM's QEMU patches (qemu-hvf-free-page-reclaim*.patch, MIT).
+
+use std::sync::mpsc::{channel, Receiver, Sender};
+use std::thread;
+use std::time::Duration;
+
+use hvf::bindings::{
+    hv_vm_map, hv_vm_unmap, HV_MEMORY_EXEC, HV_MEMORY_READ, HV_MEMORY_WRITE, HV_SUCCESS,
+};
+
+type MachPort = u32;
+
+const KERN_SUCCESS: i32 = 0;
+const VM_FLAGS_ANYWHERE: i32 = 1;
+const VM_INHERIT_NONE: u32 = 2;
+
+extern "C" {
+    static mach_task_self_: MachPort;
+
+    fn mach_vm_remap(
+        target_task: MachPort,
+        target_address: *mut u64,
+        size: u64,
+        mask: u64,
+        flags: i32,
+        src_task: MachPort,
+        src_address: u64,
+        copy: i32,
+        cur_protection: *mut i32,
+        max_protection: *mut i32,
+        inheritance: u32,
+    ) -> i32;
+}
+
+/// A moved-aside range the worker releases.
+struct Aside {
+    addr: u64,
+    len: usize,
+}
+
+pub(crate) struct Reclaim {
+    worker: Sender<Aside>,
+}
+
+impl Reclaim {
+    pub(crate) fn new() -> Reclaim {
+        let (worker, ranges) = channel();
+        thread::Builder::new()
+            .name("balloon reclaim".into())
+            .spawn(move || release_worker(ranges))
+            .expect("failed to spawn the balloon reclaim thread");
+        Reclaim { worker }
+    }
+
+    /// Replaces the reported range [gpa, gpa + len), mapped at host, with fresh memory. The
+    /// guest touches none of it until the report is acknowledged.
+    pub(crate) fn give_back(&self, gpa: u64, host: *mut u8, len: usize) {
+        let page = page_size();
+        if len == 0 || (gpa as usize | host as usize | len) % page != 0 {
+            return;
+        }
+
+        // SAFETY: hv_vm_unmap only touches the hypervisor's map of this guest range.
+        if unsafe { hv_vm_unmap(gpa, len) } != HV_SUCCESS {
+            error!("balloon: hv_vm_unmap failed for gpa={gpa:#x} len={len}");
+            return;
+        }
+
+        let task = unsafe { mach_task_self_ };
+        let mut aside: u64 = 0;
+        let (mut cur, mut max) = (0, 0);
+        // SAFETY: maps the same pages a second time at a new address; nothing is moved.
+        let moved = unsafe {
+            mach_vm_remap(
+                task,
+                &mut aside,
+                len as u64,
+                0,
+                VM_FLAGS_ANYWHERE,
+                task,
+                host as u64,
+                0,
+                &mut cur,
+                &mut max,
+                VM_INHERIT_NONE,
+            )
+        } == KERN_SUCCESS;
+
+        // SAFETY: replaces the range in place; the guest memory mapping stays the same size.
+        let fresh = unsafe {
+            libc::mmap(
+                host as *mut libc::c_void,
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_FIXED | libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if fresh != host as *mut libc::c_void {
+            panic!(
+                "balloon: new backing for gpa={gpa:#x} len={len} failed: {}",
+                std::io::Error::last_os_error()
+            );
+        }
+
+        let flags = (HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC) as u64;
+        // SAFETY: host is a live mapping of len bytes, the guest's view of gpa.
+        if unsafe { hv_vm_map(host as *mut libc::c_void, gpa, len, flags) } != HV_SUCCESS {
+            panic!("balloon: hv_vm_map failed for gpa={gpa:#x} len={len}");
+        }
+
+        if moved {
+            // The worker lives as long as the process; a send can't fail.
+            let _ = self.worker.send(Aside { addr: aside, len });
+        }
+    }
+}
+
+/// Advises each moved-aside range MADV_FREE_REUSABLE and unmaps it. Pages macOS is compressing
+/// at that moment are skipped by the advice, so a batch is advised twice, 20 ms apart.
+fn release_worker(ranges: Receiver<Aside>) {
+    while let Ok(first) = ranges.recv() {
+        let batch: Vec<Aside> = std::iter::once(first).chain(ranges.try_iter()).collect();
+        for pass in 0..2 {
+            if pass > 0 {
+                thread::sleep(Duration::from_millis(20));
+            }
+            for r in &batch {
+                // SAFETY: the range is our own second mapping of pages no one else maps.
+                unsafe {
+                    libc::madvise(
+                        r.addr as *mut libc::c_void,
+                        r.len,
+                        libc::MADV_FREE_REUSABLE,
+                    )
+                };
+            }
+        }
+        for r in &batch {
+            // SAFETY: as above; nothing else refers to this mapping.
+            unsafe { libc::munmap(r.addr as *mut libc::c_void, r.len) };
+        }
+    }
+}
+
+fn page_size() -> usize {
+    // SAFETY: sysconf has no preconditions.
+    unsafe { libc::sysconf(libc::_SC_PAGESIZE) as usize }
+}
