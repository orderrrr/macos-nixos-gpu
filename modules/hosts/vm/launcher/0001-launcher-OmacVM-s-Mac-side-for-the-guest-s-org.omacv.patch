--- /dev/null
+++ b/host/launcher/Sources/steamac-vm/OmacCamera.swift
@@ -0,0 +1,568 @@
+// From OmacVM (github.com/gillesgoetsch/omacvm), MIT, (c) 2026 Gilles Goetsch: app/app/Sources/OmacVM/camera.swift.
+// Changed for libkrun's port (one connection that never ends): CameraChannel never drops it (see there).
+// The Mac's camera for Linux apps in the VM, for OmacVM.app (over a virtio
+// port; app/app/Sources/OmacVM/camera.swift is a link to this file; the
+// Bridge no longer carries it). Tested by ../test-camera.sh.
+// Capture, frame size and wire format from try-omarchy
+// (github.com/omacom/try-omarchy, macos/Sources/OmarchyVMHelper/NativeCameraBridge.swift),
+// MIT, (c) Try Omarchy contributors.
+//
+// One connection per VM (a TCP socket or QEMU's chardev socket), both ways:
+//   VM -> Mac  one JSON object per line: {"type": "start"} or {"type": "stop"}
+//   Mac -> VM  messages: "TOCM", version 1, kind (1 status, 2 frame), 0, 0,
+//              payload length and sequence (UInt32, little-endian), payload.
+//              status: JSON, {"status": "idle" | "streaming" | "unavailable", ...}
+//              frame: 1280x720 NV12, 1,382,400 bytes
+// The camera (and its green light) is on only while a VM said start and has
+// not said stop or gone away; the VM says start only while a Linux app reads
+// its camera. A frame is dropped for a VM that has not taken the last one yet.
+// OMACVM_CAMERA=test: a moving test picture instead of the camera (no
+// permission needed; for checking the way to the VM).
+// The camera is picked again at every start (pickCamera), and a start comes
+// after every loss: the lid closed (the built-in camera is suspended), the
+// camera unplugged, or no picture from it for 5 s. So a VM that still reads
+// gets the next camera there is, or the same one once it is back.
+import AVFoundation
+import CoreMedia
+import CoreVideo
+import Darwin
+import Foundation
+
+enum CameraWire {
+  static let width = 1280, height = 720, fps = 30
+  static let frameBytes = width * height * 3 / 2
+
+  static func message(kind: UInt8, sequence: UInt32, payload: Data) -> Data {
+    var d = Data(capacity: 16 + payload.count)
+    d.append(contentsOf: [0x54, 0x4f, 0x43, 0x4d, 1, kind, 0, 0])   // "TOCM", version, kind, reserved
+    for v in [UInt32(payload.count), sequence] { withUnsafeBytes(of: v.littleEndian) { d.append(contentsOf: $0) } }
+    d.append(payload)
+    return d
+  }
+
+  static func status(_ fields: [String: Any]) -> Data {
+    let json = (try? JSONSerialization.data(withJSONObject: fields, options: [.sortedKeys])) ?? Data("{}".utf8)
+    return message(kind: 1, sequence: 0, payload: json)
+  }
+}
+
+/// macOS's camera permission for this app: granted, not-determined, denied or restricted.
+func cameraPermission() -> String {
+  switch AVCaptureDevice.authorizationStatus(for: .video) {
+  case .authorized: return "granted"
+  case .notDetermined: return "not-determined"
+  case .denied: return "denied"
+  default: return "restricted"
+  }
+}
+
+/// A camera macOS lists, as pickCamera sees it. usable: connected, and not
+/// suspended (a MacBook's own camera with the lid closed).
+struct CameraChoice: Equatable {
+  let id: String, builtIn: Bool, usable: Bool
+}
+
+/// The camera the VM gets: the built-in one while it can be used, else
+/// macOS's default camera, else the first one that can be used; nil: none.
+func pickCamera(_ cameras: [CameraChoice], systemDefault: String?) -> String? {
+  if let c = cameras.first(where: { $0.builtIn && $0.usable }) { return c.id }
+  if let d = systemDefault, cameras.contains(where: { $0.id == d && $0.usable }) { return d }
+  return cameras.first { $0.usable }?.id
+}
+
+/// Every video camera macOS lists now (built-in, USB and display cameras, Continuity Camera).
+func cameraDevices() -> [AVCaptureDevice] {
+  var types: [AVCaptureDevice.DeviceType] = [.builtInWideAngleCamera]
+  if #available(macOS 14.0, *) { types += [.external, .continuityCamera] } else { types.append(.externalUnknown) }
+  return AVCaptureDevice.DiscoverySession(deviceTypes: types, mediaType: .video, position: .unspecified).devices
+}
+
+func cameraUsable(_ d: AVCaptureDevice) -> Bool {
+  guard d.isConnected else { return false }
+  if #available(macOS 14.0, *), d.isSuspended { return false }
+  return true
+}
+
+/// The camera the VM gets now (pickCamera).
+func cameraDevice() -> AVCaptureDevice? {
+  let devices = cameraDevices()
+  let choices = devices.map { CameraChoice(id: $0.uniqueID, builtIn: $0.deviceType == .builtInWideAngleCamera, usable: cameraUsable($0)) }
+  guard let id = pickCamera(choices, systemDefault: AVCaptureDevice.default(for: .video)?.uniqueID) else { return nil }
+  return devices.first { $0.uniqueID == id }
+}
+
+struct CameraError: Error {
+  let reason: String, message: String   // reason: permission, no-camera, capture
+}
+
+/// What CameraHub needs of a camera: CameraCapture, or a stand-in in the offline test.
+protocol CameraSource: AnyObject {
+  var test: Bool { get }
+  var onFrame: ((Data) -> Void)? { get set }
+  var onFailure: ((String) -> Void)? { get set }
+  /// A camera was connected (to try again at once while one is missing).
+  var onCameraAdded: (() -> Void)? { get set }
+  func start(_ done: @escaping (Result<String, CameraError>) -> Void)
+  func stop()
+}
+
+/// One capture session (or the test picture). CameraHub starts and stops it.
+/// Each start makes a new session with the camera picked then; stop ends it.
+final class CameraCapture: NSObject, AVCaptureVideoDataOutputSampleBufferDelegate, CameraSource, @unchecked Sendable {
+  private let queue = DispatchQueue(label: "omacvm.camera.session")
+  private let frames = DispatchQueue(label: "omacvm.camera.frames", qos: .userInitiated)
+  private var session: AVCaptureSession?
+  private var observers: [NSObjectProtocol] = []
+  private var suspendWatch: NSKeyValueObservation?
+  private var addedWatch: NSObjectProtocol?
+  private var timer: DispatchSourceTimer?
+  private var reportedBadFrame = false
+  let test = ProcessInfo.processInfo.environment["OMACVM_CAMERA"] == "test"
+  var onFrame: ((Data) -> Void)?
+  var onFailure: ((String) -> Void)?
+  var onCameraAdded: (() -> Void)?
+
+  override init() {
+    super.init()
+    addedWatch = NotificationCenter.default.addObserver(forName: AVCaptureDevice.wasConnectedNotification, object: nil, queue: nil) {
+      [weak self] _ in self?.onCameraAdded?()
+    }
+  }
+
+  /// Starts capturing; done gets the camera's name. Asks for the permission
+  /// first when macOS has not asked yet (its prompt shows now).
+  func start(_ done: @escaping (Result<String, CameraError>) -> Void) {
+    if test {
+      queue.async { self.startTestPicture(); done(.success("test picture")) }
+      return
+    }
+    switch AVCaptureDevice.authorizationStatus(for: .video) {
+    case .authorized:
+      queue.async { self.startSession(done) }
+    case .notDetermined:
+      AVCaptureDevice.requestAccess(for: .video) { granted in
+        if granted { self.queue.async { self.startSession(done) } }
+        else { done(.failure(CameraError(reason: "permission", message: "camera permission not given"))) }
+      }
+    default:
+      done(.failure(CameraError(reason: "permission", message: "camera permission denied (System Settings > Privacy & Security > Camera)")))
+    }
+  }
+
+  /// Ends the session: the next start picks the camera again (the lid may
+  /// have closed, a camera gone or come since).
+  func stop() {
+    queue.async { self.endSession() }
+  }
+
+  private func endSession() {   // on queue
+    timer?.cancel(); timer = nil
+    session?.stopRunning()
+    session = nil
+    observers.forEach { NotificationCenter.default.removeObserver($0) }
+    observers = []
+    suspendWatch?.invalidate(); suspendWatch = nil
+  }
+
+  private func startSession(_ done: (Result<String, CameraError>) -> Void) {
+    do {
+      endSession()
+      let s = try makeSession()
+      session = s
+      s.startRunning()
+      guard s.isRunning else { throw CameraError(reason: "capture", message: "the camera did not start") }
+      reportedBadFrame = false
+      done(.success((s.inputs.first as? AVCaptureDeviceInput)?.device.localizedName ?? "camera"))
+    } catch let e as CameraError {
+      done(.failure(e))
+    } catch {
+      done(.failure(CameraError(reason: "capture", message: "\(error.localizedDescription)")))
+    }
+  }
+
+  private func makeSession() throws -> AVCaptureSession {
+    guard let device = cameraDevice() else { throw CameraError(reason: "no-camera", message: "this Mac has no camera") }
+    let input = try AVCaptureDeviceInput(device: device)
+    let output = AVCaptureVideoDataOutput()
+    output.alwaysDiscardsLateVideoFrames = true
+    // AVFoundation scales to this size when the camera has no 720p mode.
+    output.videoSettings = [
+      kCVPixelBufferPixelFormatTypeKey as String: Int(kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange),
+      kCVPixelBufferWidthKey as String: CameraWire.width,
+      kCVPixelBufferHeightKey as String: CameraWire.height,
+    ]
+    output.setSampleBufferDelegate(self, queue: frames)
+    let s = AVCaptureSession()
+    s.beginConfiguration()
+    defer { s.commitConfiguration() }
+    // The default preset gives 1080p on FaceTime HD cameras even in a 720p format.
+    if s.canSetSessionPreset(.hd1280x720) { s.sessionPreset = .hd1280x720 }
+    guard s.canAddInput(input), s.canAddOutput(output) else {
+      throw CameraError(reason: "capture", message: "the camera cannot be used (another app holds it?)")
+    }
+    s.addInput(input)
+    s.addOutput(output)
+    // 1280x720 at 30 fps when the camera has it, set inside the configuration.
+    let format = device.formats.first { f in
+      let d = CMVideoFormatDescriptionGetDimensions(f.formatDescription)
+      return d.width == CameraWire.width && d.height == CameraWire.height
+        && f.videoSupportedFrameRateRanges.contains { $0.minFrameRate <= Double(CameraWire.fps) && $0.maxFrameRate >= Double(CameraWire.fps) }
+    }
+    if let format, (try? device.lockForConfiguration()) != nil {
+      device.activeFormat = format
+      let t = CMTime(value: 1, timescale: CMTimeScale(CameraWire.fps))
+      device.activeVideoMinFrameDuration = t
+      device.activeVideoMaxFrameDuration = t
+      device.unlockForConfiguration()
+    }
+    for name in [AVCaptureSession.runtimeErrorNotification, AVCaptureSession.wasInterruptedNotification] {
+      observers.append(NotificationCenter.default.addObserver(forName: name, object: s, queue: nil) { [weak self] n in
+        self?.onFailure?(n.name == AVCaptureSession.runtimeErrorNotification ? "the camera reported an error" : "the camera was taken away")
+      })
+    }
+    // Unplugged, or (a MacBook's own camera) the lid closed.
+    let name = device.localizedName
+    observers.append(NotificationCenter.default.addObserver(forName: AVCaptureDevice.wasDisconnectedNotification, object: device, queue: nil) {
+      [weak self] _ in self?.onFailure?("\(name) is gone")
+    })
+    if #available(macOS 14.0, *) {
+      suspendWatch = device.observe(\.isSuspended, options: [.new]) { [weak self] d, _ in
+        if d.isSuspended { self?.onFailure?("\(name) is suspended (the lid closed?)") }
+      }
+    }
+    return s
+  }
+
+  func captureOutput(_ output: AVCaptureOutput, didOutput sampleBuffer: CMSampleBuffer, from connection: AVCaptureConnection) {
+    guard let pb = CMSampleBufferGetImageBuffer(sampleBuffer) else { return }
+    if let payload = nv12(pb) { onFrame?(payload) }
+    else if !reportedBadFrame {
+      reportedBadFrame = true
+      onFailure?(String(format: "the camera gives %dx%d frames in format 0x%08x, not 1280x720 NV12",
+                        CVPixelBufferGetWidth(pb), CVPixelBufferGetHeight(pb), CVPixelBufferGetPixelFormatType(pb)))
+    }
+  }
+
+  /// The frame as packed NV12: the luma rows, then the interleaved chroma rows.
+  private func nv12(_ pb: CVPixelBuffer) -> Data? {
+    guard CVPixelBufferGetPixelFormatType(pb) == kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange,
+          CVPixelBufferGetWidth(pb) == CameraWire.width, CVPixelBufferGetHeight(pb) == CameraWire.height,
+          CVPixelBufferGetPlaneCount(pb) == 2 else { return nil }
+    CVPixelBufferLockBaseAddress(pb, .readOnly)
+    defer { CVPixelBufferUnlockBaseAddress(pb, .readOnly) }
+    var payload = Data(count: CameraWire.frameBytes)
+    let ok = payload.withUnsafeMutableBytes { (dst: UnsafeMutableRawBufferPointer) -> Bool in
+      guard let base = dst.baseAddress else { return false }
+      var off = 0
+      for plane in 0..<2 {
+        // Both planes hold `width` bytes per row (the chroma plane: width/2 pairs).
+        let rows = CVPixelBufferGetHeightOfPlane(pb, plane), stride = CVPixelBufferGetBytesPerRowOfPlane(pb, plane)
+        guard let src = CVPixelBufferGetBaseAddressOfPlane(pb, plane),
+              rows == (plane == 0 ? CameraWire.height : CameraWire.height / 2), stride >= CameraWire.width,
+              off + rows * CameraWire.width <= dst.count else { return false }
+        for r in 0..<rows {
+          memcpy(base + off, src + r * stride, CameraWire.width)
+          off += CameraWire.width
+        }
+      }
+      return off == dst.count
+    }
+    return ok ? payload : nil
+  }
+
+  /// Bands that move down the picture, 30 times a second.
+  private func startTestPicture() {
+    timer?.cancel()
+    var tick = 0
+    let t = DispatchSource.makeTimerSource(queue: frames)
+    t.schedule(deadline: .now(), repeating: 1.0 / Double(CameraWire.fps))
+    t.setEventHandler { [weak self] in
+      tick += 1
+      var p = Data(count: CameraWire.frameBytes)
+      p.withUnsafeMutableBytes { (b: UnsafeMutableRawBufferPointer) in
+        guard let base = b.baseAddress else { return }
+        for r in 0..<CameraWire.height {
+          memset(base + r * CameraWire.width, Int32(16 + ((r / 4 + tick * 4) % 220)), CameraWire.width)
+        }
+        memset(base + CameraWire.width * CameraWire.height, 128, CameraWire.width * CameraWire.height / 2)
+      }
+      self?.onFrame?(p)
+    }
+    t.resume()
+    timer = t
+  }
+}
+
+/// One VM's connection: writes go through its own queue, so a slow VM never
+/// holds up the camera or another VM.
+final class CameraChannel: @unchecked Sendable {
+  let fd: Int32, label: String
+  private let out = DispatchQueue(label: "omacvm.camera.out")
+  private let lock = NSLock()
+  private var pending = false, closed = false
+
+  init(fd: Int32, label: String) {
+    self.fd = fd; self.label = label
+    var one: Int32 = 1
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout<Int32>.size))
+    // libkrun's port is the only connection there will be (no reconnect as with QEMU's socket):
+    // a guest that stops reading only holds up this queue (frames are dropped meanwhile), and
+    // the agent's next run skips to the next whole message (its reader resyncs on "TOCM").
+  }
+
+  /// Queues a message; a frame is dropped while the last one is still going out.
+  func send(_ data: Data, frame: Bool = false) {
+    lock.lock()
+    if closed || (frame && pending) { lock.unlock(); return }
+    if frame { pending = true }
+    lock.unlock()
+    out.async { [self] in
+      let ok = data.withUnsafeBytes { (b: UnsafeRawBufferPointer) -> Bool in
+        var off = 0
+        while off < b.count {
+          let n = Darwin.write(fd, b.baseAddress! + off, b.count - off)
+          if n > 0 { off += n } else if n < 0 && errno == EINTR { continue } else { return false }
+        }
+        return true
+      }
+      lock.lock()
+      if frame { pending = false }
+      lock.unlock()
+      if !ok { shutdown() }   // only a broken socket
+    }
+  }
+
+  /// Ends the connection; the reading loop then sees its end.
+  func shutdown() {
+    lock.lock(); let was = closed; closed = true; lock.unlock()
+    if !was { Darwin.shutdown(fd, SHUT_RDWR) }
+  }
+}
+
+/// Every VM connection that may ask for the camera; the camera runs while at
+/// least one of them wants it.
+final class CameraHub: @unchecked Sendable {
+  private let lock = NSLock()
+  private var channels: [ObjectIdentifier: CameraChannel] = [:]
+  private var wanting = Set<ObjectIdentifier>()
+  private var state = "idle"   // idle, starting, streaming
+  private var cameraName = ""
+  private var sequence: UInt32 = 0
+  private var retryDelay: Double   // seconds; doubles up to 30, back to the first with the first frame
+  private let firstRetry: Double
+  private var problem = ""         // the last failure, logged once
+  private let capture: CameraSource
+  private let log: (String) -> Void
+  // Streaming with no frame for this long (a camera that stopped without a
+  // word): picked and started again. The first frame of a start may take
+  // longer (Continuity Camera over the air). Seconds of uptime: a sleep or a
+  // clock change does not count.
+  private let frameTimeout: Double
+  private let firstFrameTimeout: Double
+  private var lastFrame = 0.0
+  private var framed = false   // a frame since this start
+  private var watchdog: DispatchSourceTimer?
+  let maxConnections = 8
+
+  init(log: @escaping (String) -> Void, source: CameraSource = CameraCapture(), firstRetry: Double = 2, frameTimeout: Double = 5,
+       firstFrameTimeout: Double = 20) {
+    self.log = log
+    self.capture = source
+    self.firstRetry = firstRetry
+    self.retryDelay = firstRetry
+    self.frameTimeout = frameTimeout
+    self.firstFrameTimeout = firstFrameTimeout
+    capture.onFrame = { [weak self] in self?.frame($0) }
+    capture.onFailure = { [weak self] in self?.failed($0) }
+    capture.onCameraAdded = { [weak self] in self?.retryNow() }
+  }
+
+  var canAttach: Bool { lock.lock(); defer { lock.unlock() }; return channels.count < maxConnections }
+
+  /// GET /camera/status: permission, camera, how many VMs read it now.
+  func status() -> [String: Any] {
+    lock.lock(); let on = state == "streaming", readers = wanting.count, n = channels.count; lock.unlock()
+    return ["permission": capture.test ? "test" : cameraPermission(), "camera": capture.test ? "test picture" : (cameraDevice()?.localizedName as Any? ?? NSNull()),
+            "on": on, "readers": readers, "connections": n]
+  }
+
+  var summary: String {
+    lock.lock(); defer { lock.unlock() }
+    return state == "streaming" ? "on for \(wanting.count) VM\(wanting.count == 1 ? "" : "s")" : "off"
+  }
+
+  /// Serves one connection on its own thread; leftover = bytes already read past the request.
+  func attach(fd: Int32, label: String, leftover: Data = Data()) {
+    Thread.detachNewThread { self.run(fd: fd, label: label, leftover: leftover) }
+  }
+
+  /// Serves one connection until it ends, then closes it.
+  func run(fd: Int32, label: String, leftover: Data = Data()) {
+    let c = CameraChannel(fd: fd, label: label), id = ObjectIdentifier(c)
+    lock.lock(); channels[id] = c; lock.unlock()
+    c.send(CameraWire.status(["status": "idle"]))
+    var line = Data(), buf = [UInt8](repeating: 0, count: 1024)
+    func feed(_ bytes: UnsafeBufferPointer<UInt8>) -> Bool {
+      for byte in bytes {
+        if byte == 0x0A {
+          guard let o = try? JSONSerialization.jsonObject(with: line) as? [String: Any],
+                let type = o["type"] as? String, type == "start" || type == "stop" else {
+            log("\(label): not a camera request, closing"); return false
+          }
+          want(c, type == "start")
+          line.removeAll(keepingCapacity: true)
+        } else if byte != 0x0D {
+          guard line.count < 4096 else { return false }
+          line.append(byte)
+        }
+      }
+      return true
+    }
+    var going = leftover.withUnsafeBytes { feed($0.bindMemory(to: UInt8.self)) }
+    while going {
+      let n = Darwin.read(fd, &buf, buf.count)
+      if n > 0 { going = buf.withUnsafeBufferPointer { feed(UnsafeBufferPointer(rebasing: $0[0..<n])) } }
+      else if n < 0 && errno == EINTR { continue }
+      else { going = false }
+    }
+    lock.lock()
+    channels[id] = nil
+    let wanted = wanting.remove(id) != nil, none = wanting.isEmpty
+    lock.unlock()
+    c.shutdown()
+    Darwin.close(fd)
+    if wanted && none { stopCapture() }
+  }
+
+  private func want(_ c: CameraChannel, _ on: Bool) {
+    let id = ObjectIdentifier(c)
+    lock.lock()
+    let changed = on ? wanting.insert(id).inserted : wanting.remove(id) != nil
+    let st = state, none = wanting.isEmpty, name = cameraName
+    if changed && on && st == "idle" { state = "starting" }
+    lock.unlock()
+    guard changed else { return }
+    if on {
+      if st == "streaming" { c.send(streaming(name)) }
+      else if st == "idle" { log("\(c.label) wants the camera"); startCapture() }   // starting: the status comes when it is up
+    } else {
+      c.send(CameraWire.status(["status": "idle"]))
+      if none { stopCapture() }
+    }
+  }
+
+  private func streaming(_ name: String) -> Data {
+    CameraWire.status(["status": "streaming", "name": name, "width": CameraWire.width, "height": CameraWire.height,
+                       "fps": CameraWire.fps, "pixelFormat": "NV12"])
+  }
+
+  private func startCapture() {   // state is "starting"
+    capture.start { [self] result in
+      lock.lock()
+      if wanting.isEmpty {   // nobody left by the time it started
+        state = "idle"; lock.unlock()
+        capture.stop()
+        return
+      }
+      let targets = wanting.compactMap { channels[$0] }
+      switch result {
+      case .success(let name):
+        state = "streaming"; cameraName = name
+        lastFrame = ProcessInfo.processInfo.systemUptime; framed = false
+        let retrying = !problem.isEmpty   // "back" comes with the first frame
+        lock.unlock()
+        watch()
+        if !retrying { log("on (\(name))") }
+        targets.forEach { $0.send(streaming(name)) }
+      case .failure(let e):
+        state = "idle"
+        let new = problem != e.message; problem = e.message
+        retryLater()
+        lock.unlock()
+        if new { log("unavailable: \(e.message) (trying again while a VM wants it)") }
+        targets.forEach { $0.send(CameraWire.status(["status": "unavailable", "reason": e.reason])) }
+      }
+    }
+  }
+
+  private func stopCapture() {
+    lock.lock(); let was = state; state = "idle"; retryDelay = firstRetry; problem = ""; lock.unlock()
+    guard was != "idle" else { return }
+    capture.stop()
+    log("off (no VM reads it)")
+  }
+
+  private func failed(_ message: String) {
+    lock.lock()
+    let was = state
+    guard was == "streaming" else { lock.unlock(); return }
+    state = "idle"
+    let targets = wanting.compactMap { channels[$0] }
+    let new = problem != message; problem = message
+    retryLater()
+    lock.unlock()
+    capture.stop()
+    if new { log("stopped: \(message) (trying again while a VM wants it)") }
+    targets.forEach { $0.send(CameraWire.status(["status": "unavailable", "reason": "capture"])) }
+  }
+
+  /// Streaming: once a second, whether frames still come.
+  private func watch() {
+    let t = DispatchSource.makeTimerSource(queue: .global(qos: .utility))
+    let every = min(1.0, frameTimeout / 3)
+    t.schedule(deadline: .now() + every, repeating: every)
+    t.setEventHandler { [weak self, weak t] in
+      guard let self else { t?.cancel(); return }
+      self.lock.lock()
+      let streaming = self.state == "streaming", quiet = ProcessInfo.processInfo.systemUptime - self.lastFrame
+      let limit = self.framed ? self.frameTimeout : self.firstFrameTimeout, name = self.cameraName
+      self.lock.unlock()
+      if !streaming { t?.cancel(); return }
+      if quiet > limit { self.failed("no picture from \(name) for \(Int(limit.rounded())) s") }
+    }
+    lock.lock(); watchdog?.cancel(); watchdog = t; lock.unlock()
+    t.resume()
+  }
+
+  /// A camera was connected: while VMs want one and none runs, try at once.
+  private func retryNow() {
+    lock.lock()
+    let go = state == "idle" && !wanting.isEmpty
+    if go { state = "starting"; retryDelay = firstRetry }
+    lock.unlock()
+    if go { log("a camera was connected: trying again"); startCapture() }
+  }
+
+  /// The camera failed while VMs still want it (another app took it, the
+  /// permission is not given yet, the lid closed, it was unplugged): tries
+  /// again after 2 s, then up to every 30 s, with the camera picked then,
+  /// until it works or no VM wants it. The VMs show black meanwhile and get
+  /// "streaming" when it is back. Lock held.
+  private func retryLater() {
+    let delay = retryDelay
+    retryDelay = min(retryDelay * 2, 30)
+    DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + delay) { [self] in
+      lock.lock()
+      let go = state == "idle" && !wanting.isEmpty
+      if go { state = "starting" }
+      lock.unlock()
+      if go { startCapture() }
+    }
+  }
+
+  private func frame(_ payload: Data) {
+    lock.lock()
+    guard state == "streaming" else { lock.unlock(); return }
+    lastFrame = ProcessInfo.processInfo.systemUptime; framed = true
+    if retryDelay != firstRetry || !problem.isEmpty {   // it works again
+      if !problem.isEmpty { log("back: \(cameraName)") }
+      retryDelay = firstRetry; problem = ""
+    }
+    sequence &+= 1
+    let seq = sequence, targets = wanting.compactMap { channels[$0] }
+    lock.unlock()
+    guard !targets.isEmpty else { return }
+    let m = CameraWire.message(kind: 2, sequence: seq, payload: payload)
+    targets.forEach { $0.send(m, frame: true) }
+  }
+}
diff --git a/host/launcher/Sources/steamac-vm/OmacHostBattery.swift b/host/launcher/Sources/steamac-vm/OmacHostBattery.swift
new file mode 100644
index 0000000..707ece3
--- /dev/null
+++ b/host/launcher/Sources/steamac-vm/OmacHostBattery.swift
@@ -0,0 +1,196 @@
+// From OmacVM (github.com/gillesgoetsch/omacvm), MIT, (c) 2026 Gilles Goetsch: app/app/Sources/OmacVM/HostBattery.swift, unchanged.
+// The Mac's battery for the VM: one snapshot of its power sources, as JSON.
+// (The Bridge's copy went with the retired routes in 3.4.0.)
+//
+// From try-omarchy (github.com/omacom/try-omarchy), MIT, (c) Try Omarchy
+// contributors: macos/Sources/OmarchyVMHelper/NativeBatteryBridge.swift
+// (HostBatterySnapshot), HostBatteryDetails.swift, HostChargeLimit.swift.
+import Foundation
+import IOKit
+import IOKit.ps
+
+/// One complete snapshot of the Mac's power sources.
+struct HostBatterySnapshot: Equatable {
+    let present: Bool
+    let percentage: Int?
+    let state: String
+    let acConnected: Bool
+    let timeToEmptySeconds: Int?
+    let timeToFullSeconds: Int?
+    let chargeLimit: Int?
+    let details: HostBatteryDetails
+
+    init(descriptions: [[String: Any]], chargeLimit: Int? = nil, details: HostBatteryDetails = HostBatteryDetails()) {
+        let internalBattery = descriptions.first {
+            $0[kIOPSTypeKey] as? String == kIOPSInternalBatteryType && $0[kIOPSIsPresentKey] as? Bool != false
+        }
+        guard let battery = internalBattery else {
+            present = false; percentage = nil; state = "unknown"; acConnected = true
+            timeToEmptySeconds = nil; timeToFullSeconds = nil; self.chargeLimit = nil; self.details = HostBatteryDetails()
+            return
+        }
+        present = true
+        self.details = details
+        self.chargeLimit = chargeLimit.flatMap { (1..<100).contains($0) ? $0 : nil }
+        let current = battery[kIOPSCurrentCapacityKey] as? Int ?? 0
+        let maximum = battery[kIOPSMaxCapacityKey] as? Int ?? 100
+        percentage = maximum > 0 ? min(100, max(0, current * 100 / maximum)) : 0
+        let onMains = battery[kIOPSPowerSourceStateKey] as? String == kIOPSACPowerValue
+        acConnected = onMains
+        if battery[kIOPSIsChargingKey] as? Bool == true { state = "charging" }
+        else if battery[kIOPSIsChargedKey] as? Bool == true { state = "full" }
+        else if onMains { state = "not-charging" }
+        else { state = "discharging" }
+        func seconds(_ key: String) -> Int? {
+            guard let minutes = battery[key] as? Int, minutes >= 0 else { return nil }
+            return minutes * 60
+        }
+        timeToEmptySeconds = state == "discharging" ? seconds(kIOPSTimeToEmptyKey) : nil
+        timeToFullSeconds = state == "charging" ? seconds(kIOPSTimeToFullChargeKey) : nil
+    }
+
+    /// One line for the virtio port.
+    var line: Data {
+        var data = (try? JSONSerialization.data(withJSONObject: dictionary, options: [.sortedKeys])) ?? Data("{}".utf8)
+        data.append(0x0A)
+        return data
+    }
+
+    var dictionary: [String: Any] {
+        [
+            "type": "state",
+            "present": present,
+            "percentage": percentage as Any? ?? NSNull(),
+            "state": state,
+            "acConnected": acConnected,
+            "timeToEmptySeconds": timeToEmptySeconds as Any? ?? NSNull(),
+            "timeToFullSeconds": timeToFullSeconds as Any? ?? NSNull(),
+            "chargeLimit": chargeLimit as Any? ?? NSNull(),
+            "chargeNowMicroAh": details.chargeNowMicroAh as Any? ?? NSNull(),
+            "chargeFullMicroAh": details.chargeFullMicroAh as Any? ?? NSNull(),
+            "chargeFullDesignMicroAh": details.chargeFullDesignMicroAh as Any? ?? NSNull(),
+            "voltageMicroV": details.voltageMicroV as Any? ?? NSNull(),
+            "cycleCount": details.cycleCount as Any? ?? NSNull(),
+            "currentMicroA": details.currentMicroA as Any? ?? NSNull(),
+            "powerMicroW": details.powerMicroW as Any? ?? NSNull(),
+        ]
+    }
+
+    static func capture() -> HostBatterySnapshot {
+        guard let blob = IOPSCopyPowerSourcesInfo()?.takeRetainedValue(),
+                    let list = IOPSCopyPowerSourcesList(blob)?.takeRetainedValue() as? [CFTypeRef] else {
+            return HostBatterySnapshot(descriptions: [])
+        }
+        let descriptions = list.compactMap {
+            IOPSGetPowerSourceDescription(blob, $0)?.takeUnretainedValue() as? [String: Any]
+        }
+        return HostBatterySnapshot(descriptions: descriptions, chargeLimit: HostChargeLimit.capture(),
+                                                              details: HostBatteryDetails.capture())
+    }
+}
+
+/// The battery's own readings (AppleSmartBattery), apart from the 0-100
+/// capacities above: charge in µAh, voltage in µV, current in µA and power
+/// in µW, as Linux wants them. Current is signed: below 0 while the battery
+/// gives power (discharging), as AppleSmartBattery's "Amperage" (mA).
+struct HostBatteryDetails: Equatable {
+    let chargeNowMicroAh: Int?
+    let chargeFullMicroAh: Int?
+    let chargeFullDesignMicroAh: Int?
+    let voltageMicroV: Int?
+    let cycleCount: Int?
+    let currentMicroA: Int?
+    let powerMicroW: Int?
+
+    init(properties: [String: Any] = [:]) {
+        let data = properties["BatteryData"] as? [String: Any] ?? [:]
+        func reading(_ candidates: [Any?], multiplier: Int = 1, minimum: Int = 0) -> Int? {
+            for candidate in candidates {
+                guard let number = candidate as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(),
+                            let value = candidate as? Int, value >= minimum, value <= Int(Int32.max) / multiplier else { continue }
+                return value * multiplier
+            }
+            return nil
+        }
+        chargeNowMicroAh = reading([properties["AppleRawCurrentCapacity"], data["RemainingCapacity"]], multiplier: 1000)
+        chargeFullMicroAh = reading([properties["AppleRawMaxCapacity"], data["FullChargeCapacity"]], multiplier: 1000, minimum: 1)
+        chargeFullDesignMicroAh = reading([properties["DesignCapacity"], data["DesignCapacity"]], multiplier: 1000, minimum: 1)
+        voltageMicroV = reading([properties["Voltage"]], multiplier: 1000, minimum: 1)
+        cycleCount = reading([properties["CycleCount"]])
+        // Amperage is averaged by the battery (InstantAmperage is not): steadier
+        // watts and time left. Power is current x voltage of the same reading,
+        // so the watts and UPower's time left (charge / current) agree.
+        let milliAmps = [properties["Amperage"], properties["InstantAmperage"]].lazy
+            .compactMap(HostBatteryDetails.signedMilliamps).first
+        currentMicroA = milliAmps.map { $0 * 1000 }
+        if let milliAmps, let millivolts = voltageMicroV.map({ $0 / 1000 }) {
+            let microWatts = abs(milliAmps) * millivolts   // mA x mV = µW
+            powerMicroW = microWatts <= Int(Int32.max) ? microWatts : nil
+        } else {
+            powerMicroW = nil
+        }
+    }
+
+    /// A signed current in mA from IOKit, or nil. IOKit keeps it as a signed
+    /// 32-bit number; ioreg prints it as unsigned 64-bit (-573 shows as
+    /// 18446744073709551043), so a wrapped 64- or 32-bit value is read back as
+    /// signed too. More than ±2147 A (beyond Int32 in µA) is not a reading.
+    static func signedMilliamps(_ candidate: Any?) -> Int? {
+        guard let number = candidate as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID() else { return nil }
+        var value = number.int64Value              // UInt64 above Int64.max: its bit pattern
+        if value > Int64(Int32.max) && value <= Int64(UInt32.max) {
+            value = Int64(Int32(truncatingIfNeeded: value))
+        }
+        let limit = Int64(Int32.max / 1000)
+        guard value >= -limit && value <= limit else { return nil }
+        return Int(value)
+    }
+
+    static func capture() -> HostBatteryDetails {
+        let service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("AppleSmartBattery"))
+        guard service != 0 else { return HostBatteryDetails() }
+        defer { IOObjectRelease(service) }
+        var unmanaged: Unmanaged<CFMutableDictionary>?
+        guard IORegistryEntryCreateCFProperties(service, &unmanaged, kCFAllocatorDefault, 0) == KERN_SUCCESS,
+                    let properties = unmanaged?.takeRetainedValue() as? [String: Any],
+                    properties["BatteryInstalled"] as? Bool != false else { return HostBatteryDetails() }
+        return HostBatteryDetails(properties: properties)
+    }
+}
+
+/// The charge limit set in macOS (System Settings › Battery), read from
+/// powerd's file. Undocumented: missing or changed means no limit.
+enum HostChargeLimit {
+    static let policyURL = URL(fileURLWithPath: "/Library/Preferences/com.apple.powerd.charging.plist")
+
+    static func capture() -> Int? {
+        guard let data = try? Data(contentsOf: policyURL),
+                    let plist = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],
+                    let archive = plist["policies"] as? Data,
+                    let decoder = try? NSKeyedUnarchiver(forReadingFrom: archive) else { return nil }
+        decoder.decodingFailurePolicy = .setErrorAndReturn
+        decoder.setClass(HostChargingPolicy.self, forClassName: "ChargeCtrlPolicy")
+        defer { decoder.finishDecoding() }
+        guard let policies = decoder.decodeObject(of: [NSArray.self, HostChargingPolicy.self, NSString.self],
+                                                                                            forKey: NSKeyedArchiveRootObjectKey) as? [HostChargingPolicy],
+                    decoder.error == nil else { return nil }
+        return policies.filter { $0.reason == "manualChargeLimit" && !$0.terminated && (1..<100).contains($0.limit) }
+            .map(\.limit).min()
+    }
+}
+
+@objc(OmacVMHostChargingPolicy)
+private final class HostChargingPolicy: NSObject, NSSecureCoding {
+    static var supportsSecureCoding: Bool { true }
+    let reason: String?
+    let limit: Int
+    let terminated: Bool
+
+    required init?(coder: NSCoder) {
+        reason = coder.decodeObject(of: NSString.self, forKey: "reason") as String?
+        limit = coder.decodeInteger(forKey: "soclimit")
+        terminated = coder.decodeBool(forKey: "terminated")
+    }
+
+    func encode(with coder: NSCoder) { preconditionFailure("read-only") }
+}
diff --git a/host/launcher/Sources/steamac-vm/OmacMediaClaim.swift b/host/launcher/Sources/steamac-vm/OmacMediaClaim.swift
new file mode 100644
index 0000000..61034d5
--- /dev/null
+++ b/host/launcher/Sources/steamac-vm/OmacMediaClaim.swift
@@ -0,0 +1,340 @@
+// From OmacVM (github.com/gillesgoetsch/omacvm), MIT, (c) 2026 Gilles Goetsch:
+// app/app/Sources/OmacVMMedia/MediaClaim.swift, unchanged. The org.omacvm.* guest agents expect exactly this protocol.
+import Foundation
+
+/// The commands macOS gives the Now Playing app (MPRemoteCommandCenter) that
+/// OmacVM takes. Skip and seek stay off, so a double or triple press on
+/// AirPods stays next and previous.
+public enum RemoteCommand: String, CaseIterable, Sendable {
+    case play, pause, togglePlayPause, stop, nextTrack, previousTrack
+}
+
+/// When the launcher is the Mac's Now Playing app for the VM (docs/adr/0058).
+/// Events in, what to send and log out; `shown` is what Now Playing should
+/// say (nil: given up), `deadline` when `tick` is due next. No clock of its
+/// own: every event brings `now` (seconds, any monotonic clock). Only the
+/// main thread uses it (MediaSession).
+///
+/// macOS gives the controls to the last process that went into playing; a
+/// paused one keeps them; removing the targets gives them up (the spike,
+/// tracks/airpods-media.md). So:
+/// - claim when the switch is on, the agent said hello and its player plays;
+/// - paused: keep the claim (the next press resumes the VM), shown paused;
+/// - a non-playing state shorter than 1.5 s (a track change, buffering)
+///   leaves Now Playing as it is; playing again after a pause, or a new
+///   claim after giving up, takes Now Playing from a Mac app at most once
+///   per 10 s from the VM's side (the app's switch going on does not wait);
+/// - give up when nothing plays for 3 s, after 30 min paused, with no word
+///   from the agent for 45 s (the Mac's sleep does not count), when the
+///   switch goes off or QEMU ends;
+/// - an agent that starts again (apply) says hello: the claim stays if its
+///   first state comes within 8 s and has a player (gi, D-Bus and a busy VM
+///   take their time).
+public struct MediaClaim {
+    public enum Effect: Equatable { case send(Data), log(String) }
+    public enum Answer: Equatable { case send(MacCommand), notClaimed, noLink }
+
+    /// What Now Playing says while claimed.
+    public struct Shown: Equatable, Sendable {
+        public var title: String
+        public var artist: String
+        public var album: String
+        public var duration: Double?
+        public var elapsed: Double?
+        public var playing: Bool
+        public var rate: Double
+        public var canNext: Bool
+        public var canPrevious: Bool
+
+        public init(title: String, artist: String, album: String, duration: Double?, elapsed: Double?, playing: Bool,
+                    rate: Double, canNext: Bool, canPrevious: Bool) {
+            self.title = title; self.artist = artist; self.album = album; self.duration = duration
+            self.elapsed = elapsed; self.playing = playing; self.rate = rate
+            self.canNext = canNext; self.canPrevious = canPrevious
+        }
+
+        /// Whether Now Playing's info must be set again, `seconds` after it
+        /// was set to `old`: anything but the elapsed time changed, or that
+        /// moved more than 2 s from where the old rate had it.
+        public func needsInfo(after old: Shown?, seconds: Double) -> Bool {
+            guard let old else { return true }
+            var a = self, b = old
+            a.elapsed = nil; b.elapsed = nil
+            if a != b { return true }
+            switch (elapsed, old.elapsed) {
+            case (nil, nil): return false
+            case let (e?, o?): return abs(e - (o + old.rate * seconds)) > 2
+            default: return true
+            }
+        }
+    }
+
+    /// Whether Now Playing's info must be set again. macOS moves the elapsed
+    /// time on by itself from the info last set, so a new `Shown` is compared
+    /// with that one and the time since it was set, not with the last shown.
+    public struct InfoGate {
+        private var set: Shown?
+        private var at = 0.0
+
+        public init() {}
+
+        /// Whether `s` must be set at `now`; when it must, it counts as set.
+        public mutating func needsSet(_ s: Shown, now: Double) -> Bool {
+            guard s.needsInfo(after: set, seconds: now - at) else { return false }
+            set = s
+            at = now
+            return true
+        }
+
+        /// The info was cleared (Now Playing given up).
+        public mutating func cleared() { set = nil }
+    }
+
+    public static let settle = 1.5
+    public static let stopRelease = 3.0
+    public static let helloGrace = 8.0
+    public static let retakeEvery = 10.0
+    public static let lease = 45.0
+    public static let pausedRelease = 1800.0
+    /// After the Mac's play or pause, the agent's next states have this long to agree.
+    public static let commandHold = 1.5
+
+    public private(set) var on: Bool
+    public private(set) var claimed = false
+    public private(set) var shownPlaying = false
+    /// The agent's last state, and the last one with a player (Now Playing's text).
+    public private(set) var last: GuestState?
+    private var info: GuestState?
+    private var linked = false
+    private var helloSeen = false
+    private var invited = false
+    private var guestID: String?
+    private var agentLogged = -Double.infinity
+    private var lastLine: Double?
+    private var notPlayingSince: Double?
+    private var stoppedSince: Double?
+    private var pausedSince: Double?
+    private var lastTake = -Double.infinity
+    /// A playing state that waits for its claim (10 s since the last take).
+    private var waiting = false
+    private var graceUntil: Double?
+    private var held: (playing: Bool, until: Double)?
+    private var asleep = false
+
+    public init(on: Bool) { self.on = on }
+
+    public var shown: Shown? {
+        guard claimed, let s = info ?? last else { return nil }
+        return Shown(title: s.title.isEmpty ? s.player : s.title, artist: s.artist, album: s.album,
+                     duration: s.length, elapsed: s.position, playing: shownPlaying,
+                     rate: shownPlaying ? s.rate : 0, canNext: s.canNext, canPrevious: s.canPrevious)
+    }
+
+    /// When `tick` is due next (nil: nothing waits).
+    public var deadline: Double? {
+        guard claimed else { return waiting ? lastTake + Self.retakeEvery : nil }
+        var d: [Double] = []
+        // While held, what Now Playing shows waits for the hold's end (a retake
+        // due earlier would wake the timer every 50 ms until then).
+        if let h = held {
+            d.append(h.until)
+        } else {
+            if last?.status == .playing, !shownPlaying { d.append(lastTake + Self.retakeEvery) }
+            if shownPlaying, last?.status != .playing, let n = notPlayingSince { d.append(n + Self.settle) }
+        }
+        if let s = stoppedSince { d.append(s + Self.stopRelease) }
+        if let p = pausedSince { d.append(p + Self.pausedRelease) }
+        if let g = graceUntil { d.append(g) }
+        if !asleep, let l = lastLine { d.append(l + Self.lease) }
+        return d.min()
+    }
+
+    /// A new connection to the port (QEMU's socket): the agent must say hello on it.
+    public mutating func connected() {
+        linked = true
+        helloSeen = false
+        invited = false
+    }
+
+    /// The connection ended. The claim stays: QEMU ending is `stop`, anything
+    /// else reconnects within a second, and the lease covers an agent that
+    /// never comes back.
+    public mutating func disconnected() {
+        linked = false
+        helloSeen = false
+        waiting = false
+    }
+
+    public mutating func received(_ m: GuestMessage, now: Double) -> [Effect] {
+        switch m {
+        case .hello(let v, let id):
+            var fx: [Effect] = [.send(MediaLine.hello(on: on, id: id))]
+            if id != guestID {
+                // An agent that fails and starts again every few seconds (its
+                // unit restarts it) is said at most once a minute.
+                if now - agentLogged >= 60 {
+                    fx.append(.log("the VM's agent is there (v\(v))"))
+                    agentLogged = now
+                }
+                // An agent that started again (apply, a crash) while claimed.
+                if claimed { graceUntil = now + Self.helloGrace }
+            }
+            helloSeen = true
+            guestID = id
+            lastLine = now
+            return fx + settle(now)
+        case .state(let s):
+            guard helloSeen else {
+                // A line before any hello on this connection: ask for one, once.
+                guard linked, !invited else { return [] }
+                invited = true
+                return [.send(MediaLine.hello(on: on, id: nil))]
+            }
+            lastLine = now
+            guard on else { return [] }
+            return take(s, now: now)
+        }
+    }
+
+    private mutating func take(_ s: GuestState, now: Double) -> [Effect] {
+        let wasPlaying = last?.status == .playing
+        last = s
+        if s.status != .none { info = s }
+        graceUntil = nil
+        waiting = false
+        var fx: [Effect] = []
+        switch s.status {
+        case .playing:
+            notPlayingSince = nil; stoppedSince = nil; pausedSince = nil
+            if !claimed {
+                if now >= lastTake + Self.retakeEvery { fx += claim(now) } else { waiting = true }
+            }
+        case .paused:
+            if wasPlaying || notPlayingSince == nil { notPlayingSince = now }
+            stoppedSince = nil
+            if pausedSince == nil { pausedSince = now }
+        case .stopped, .none:
+            if wasPlaying || notPlayingSince == nil { notPlayingSince = now }
+            pausedSince = nil
+            if stoppedSince == nil { stoppedSince = now }
+        }
+        return fx + settle(now)
+    }
+
+    private mutating func claim(_ now: Double) -> [Effect] {
+        claimed = true
+        shownPlaying = true
+        lastTake = now
+        held = nil
+        waiting = false
+        let player = last?.player ?? ""
+        return [.log("Now Playing is the VM (\(player.isEmpty ? "a player" : player) playing)")]
+    }
+
+    /// What is due at `now`: Now Playing's state after the waits, and giving up.
+    public mutating func tick(now: Double) -> [Effect] { settle(now) }
+
+    private mutating func settle(_ now: Double) -> [Effect] {
+        if !claimed, waiting, now >= lastTake + Self.retakeEvery { return claim(now) }
+        guard claimed, let s = last else { return [] }
+        if let h = held, now < h.until {
+            shownPlaying = h.playing
+        } else {
+            held = nil
+            if s.status == .playing {
+                if !shownPlaying, now >= lastTake + Self.retakeEvery {
+                    shownPlaying = true
+                    lastTake = now
+                }
+            } else if shownPlaying, let n = notPlayingSince, now >= n + Self.settle {
+                shownPlaying = false
+            }
+        }
+        if let t = stoppedSince, now >= t + Self.stopRelease { return release("nothing plays in the VM") }
+        if let p = pausedSince, now >= p + Self.pausedRelease { return release("paused for 30 minutes") }
+        if let g = graceUntil, now >= g { return release("the VM's agent started again and named no player") }
+        if !asleep, let l = lastLine, now >= l + Self.lease { return release("no word from the VM's agent for 45 s") }
+        return []
+    }
+
+    private mutating func release(_ why: String) -> [Effect] {
+        guard claimed else { return [] }
+        claimed = false
+        shownPlaying = false
+        held = nil
+        graceUntil = nil
+        return [.log("Now Playing given up (\(why))")]
+    }
+
+    /// The app's switch changed while the VM runs.
+    public mutating func switched(_ on: Bool, now: Double) -> [Effect] {
+        guard on != self.on else { return [] }
+        self.on = on
+        var fx: [Effect] = [.log("\(on ? "on" : "off") (switched while the VM runs)")]
+        // The agent's next state after the hello is fresh; nothing from before counts.
+        last = nil; info = nil
+        notPlayingSince = nil; stoppedSince = nil; pausedSince = nil
+        waiting = false
+        // The person's own switch: its first claim does not wait for the VM's 10 s.
+        if on { lastTake = -Double.infinity }
+        if linked, helloSeen { fx.append(.send(MediaLine.hello(on: on, id: guestID))) }
+        if !on { fx += release("the app's switch is off") }
+        return fx
+    }
+
+    /// A command from macOS (AirPods, Control Center, a play key): what to
+    /// send the VM, from the agent's own last state (not what Now Playing shows).
+    /// Within the hold after the Mac's own play or pause, the agent's state can
+    /// still be from before it: a toggle then goes from that command (a quick
+    /// double press of a play key pauses and plays).
+    public func command(_ c: RemoteCommand, now: Double) -> Answer {
+        guard claimed, on, let s = last else { return .notClaimed }
+        guard linked, helloSeen else { return .noLink }
+        switch c {
+        case .play: return .send(.play)
+        case .pause, .stop: return .send(.pause)
+        case .togglePlayPause:
+            var playing = s.status == .playing
+            if let h = held, now < h.until { playing = h.playing }
+            return .send(playing ? .pause : .play)
+        case .nextTrack: return .send(.next)
+        case .previousTrack: return .send(.previous)
+        }
+    }
+
+    /// The command went into the port: Now Playing follows at once (the
+    /// agent's next state confirms or corrects it).
+    public mutating func commandSent(_ c: RemoteCommand, _ m: MacCommand, now: Double) -> [Effect] {
+        switch m {
+        case .play:
+            held = (true, now + Self.commandHold)
+            shownPlaying = true
+            if last?.status != .playing { notPlayingSince = now }
+        case .pause:
+            held = (false, now + Self.commandHold)
+            shownPlaying = false
+        case .next, .previous:
+            break
+        }
+        return [.log("\(c.rawValue) from macOS: \(m.rawValue) to the VM's player")]
+    }
+
+    /// The Mac goes to sleep: the claim stays, the lease waits.
+    public mutating func sleep() { asleep = true }
+
+    /// The Mac woke: the lease starts again, and the agent is asked for a fresh state.
+    public mutating func wake(now: Double) -> [Effect] {
+        asleep = false
+        if lastLine != nil { lastLine = now }
+        guard linked, helloSeen else { return [] }
+        return [.send(MediaLine.hello(on: on, id: guestID))]
+    }
+
+    /// QEMU ended (or the launcher stops the VM): give Now Playing up now.
+    public mutating func stop(_ why: String) -> [Effect] {
+        linked = false
+        helloSeen = false
+        waiting = false
+        return release(why)
+    }
+}
diff --git a/host/launcher/Sources/steamac-vm/OmacMediaProtocol.swift b/host/launcher/Sources/steamac-vm/OmacMediaProtocol.swift
new file mode 100644
index 0000000..08b488e
--- /dev/null
+++ b/host/launcher/Sources/steamac-vm/OmacMediaProtocol.swift
@@ -0,0 +1,251 @@
+// From OmacVM (github.com/gillesgoetsch/omacvm), MIT, (c) 2026 Gilles Goetsch:
+// app/app/Sources/OmacVMMedia/MediaProtocol.swift, unchanged. The org.omacvm.* guest agents expect exactly this protocol.
+import Foundation
+
+/// AirPods and media controls (docs/adr/0058-now-playing.md): the virtio port
+/// between OmacVM.app's launcher and the VM's agent omacvm-media
+/// (src/app/guest/omacvm-media), one JSON object per line, "t" says what.
+///
+/// From the VM:
+///   {"t":"hello","v":1,"n":"5f2c9a01"}   the agent started (n: this run's id);
+///                                        again every 5 s until the Mac answers
+///   {"t":"state","s":"playing","player":"Chromium","title":"..","artist":"..",
+///    "album":"..","len":213.5,"pos":12.0,"rate":1.0,"next":true,"prev":false}
+///                                        what its player does (s: playing,
+///                                        paused, stopped, none): after the
+///                                        Mac's hello, on every change, every
+///                                        15 s while it has a player
+/// To the VM:
+///   {"t":"hello","v":1,"on":true,"n":"5f2c9a01"}  the answer, with the agent's
+///                                        n (the agent takes only that one, so
+///                                        nothing left in the port from before
+///                                        counts); again when the switch changes
+///                                        and after the Mac wakes. Without n: "say
+///                                        hello again" (a line came before any
+///                                        hello on this connection)
+///   {"t":"cmd","c":"play|pause|next|previous"}
+///
+/// Both sides ignore what they do not know (t, keys, commands); the lower v
+/// counts. The guest is untrusted: a line is at most 4 KB and 20 a second, its
+/// text is cut to 200 characters (the player's name to 64) without control or
+/// direction characters, its numbers kept in range, nothing counts before its
+/// hello, and no picture comes from it.
+public enum MediaPort {
+    public static let name = "org.omacvm.media"
+    /// After mac-ime's 8; a port on vser0 moves no PCI device.
+    public static let number = 9
+    public static let version = 1
+
+    /// QEMU's arguments; `socket` as QEMU wants it (commas doubled).
+    public static func arguments(socket: String) -> [String] {
+        ["-chardev", "socket,id=media0,path=\(socket),server=on,wait=off",
+         "-device", "virtserialport,bus=vser0.0,nr=\(number),chardev=media0,name=\(name)"]
+    }
+}
+
+public enum MediaLimits {
+    public static let lineBytes = 4096
+    public static let linesPerSecond = 20
+    public static let text = 200
+    public static let player = 64
+    /// The guest's run id in its hello.
+    public static let id = 32
+    public static let longest = 86_400.0
+    public static let fastest = 4.0
+    /// JSON nesting: our lines have one object; deeper ones are not parsed.
+    public static let depth = 4
+}
+
+/// The app-wide switch "AirPods and media controls" (org.omacvm.app
+/// mediaControls). On by default; off by default for the test identity, so a
+/// test VM that plays never takes the person's AirPods.
+public enum MediaControls {
+    public static let key = "mediaControls"
+    public static func defaultOn(testIdentity: Bool) -> Bool { !testIdentity }
+}
+
+/// What the guest's player does, as the Mac reads it.
+public struct GuestState: Equatable, Sendable {
+    public enum Status: String, Sendable { case playing, paused, stopped, none }
+    public var status: Status
+    public var player = ""
+    public var title = ""
+    public var artist = ""
+    public var album = ""
+    public var length: Double?
+    public var position: Double?
+    public var rate = 1.0
+    public var canNext = false
+    public var canPrevious = false
+
+    public init(status: Status, player: String = "", title: String = "", artist: String = "", album: String = "",
+                length: Double? = nil, position: Double? = nil, rate: Double = 1.0,
+                canNext: Bool = false, canPrevious: Bool = false) {
+        self.status = status; self.player = player; self.title = title; self.artist = artist; self.album = album
+        self.length = length; self.position = position; self.rate = rate
+        self.canNext = canNext; self.canPrevious = canPrevious
+    }
+}
+
+public enum GuestMessage: Equatable, Sendable {
+    case hello(version: Int, id: String)
+    case state(GuestState)
+}
+
+/// What the Mac sends the VM's player. Never a toggle: AirPods pause when one
+/// comes out, and a toggle would start a paused video.
+public enum MacCommand: String, CaseIterable, Sendable { case play, pause, next, previous }
+
+public enum MediaLine {
+    /// One line from the guest (without its newline); nil for anything we do
+    /// not take.
+    public static func parse(_ line: Data) -> GuestMessage? {
+        guard line.count <= MediaLimits.lineBytes, shallow(line),
+              let o = try? JSONSerialization.jsonObject(with: line) as? [String: Any],
+              let t = o["t"] as? String else { return nil }
+        switch t {
+        case "hello":
+            guard let v = integer(o["v"]), v >= 1 else { return nil }
+            let id = clean(o["n"], limit: MediaLimits.id)
+            return .hello(version: v, id: id)
+        case "state":
+            guard let raw = o["s"] as? String, let status = GuestState.Status(rawValue: raw) else { return nil }
+            var s = GuestState(status: status)
+            s.player = clean(o["player"], limit: MediaLimits.player)
+            s.title = clean(o["title"], limit: MediaLimits.text)
+            s.artist = clean(o["artist"], limit: MediaLimits.text)
+            s.album = clean(o["album"], limit: MediaLimits.text)
+            s.length = number(o["len"], in: 0...MediaLimits.longest).flatMap { $0 > 0 ? $0 : nil }
+            s.position = number(o["pos"], in: 0...MediaLimits.longest).map { min($0, s.length ?? $0) }
+            s.rate = number(o["rate"], in: 0...MediaLimits.fastest) ?? 1.0
+            s.canNext = flag(o["next"])
+            s.canPrevious = flag(o["prev"])
+            return .state(s)
+        default:
+            return nil
+        }
+    }
+
+    public static func hello(on: Bool, id: String?) -> Data {
+        var o: [String: Any] = ["t": "hello", "v": MediaPort.version, "on": on]
+        if let id { o["n"] = id }
+        return encode(o)
+    }
+
+    public static func command(_ c: MacCommand) -> Data { encode(["t": "cmd", "c": c.rawValue]) }
+
+    static func encode(_ o: [String: Any]) -> Data {
+        var d = (try? JSONSerialization.data(withJSONObject: o, options: [.sortedKeys])) ?? Data("{}".utf8)
+        d.append(0x0A)
+        return d
+    }
+
+    /// The guest's text as the Mac shows it: a string cut to `limit`
+    /// characters (Unicode scalars), without control, line break or direction
+    /// characters; anything else is "".
+    public static func clean(_ v: Any?, limit: Int) -> String {
+        guard let s = v as? String else { return "" }
+        var out = String.UnicodeScalarView()
+        var n = 0
+        for u in s.unicodeScalars where !hidden(u) {
+            if n == limit { break }
+            out.append(u)
+            n += 1
+        }
+        return String(out).trimmingCharacters(in: .whitespaces)
+    }
+
+    static func hidden(_ u: Unicode.Scalar) -> Bool {
+        switch u.value {
+        case 0x00...0x1F, 0x7F...0x9F: return true   // control characters
+        case 0x061C, 0x200E, 0x200F, 0x202A...0x202E, 0x2066...0x2069: return true   // text direction
+        case 0x2028, 0x2029: return true   // line and paragraph breaks
+        default: return false
+        }
+    }
+
+    /// At most MediaLimits.depth objects or arrays inside each other (strings
+    /// skipped), so a crafted line never makes the parser go deep.
+    static func shallow(_ line: Data) -> Bool {
+        var depth = 0, inString = false, escaped = false
+        for b in line {
+            if inString {
+                if escaped { escaped = false } else if b == 0x5C { escaped = true } else if b == 0x22 { inString = false }
+                continue
+            }
+            switch b {
+            case 0x22: inString = true
+            case 0x7B, 0x5B:
+                depth += 1
+                if depth > MediaLimits.depth { return false }
+            case 0x7D, 0x5D: depth -= 1
+            default: break
+            }
+        }
+        return true
+    }
+
+    static func isBool(_ v: Any?) -> Bool {
+        guard let n = v as? NSNumber else { return false }
+        return CFGetTypeID(n) == CFBooleanGetTypeID()
+    }
+
+    static func flag(_ v: Any?) -> Bool { isBool(v) && (v as? Bool) == true }
+
+    static func integer(_ v: Any?) -> Int? {
+        guard !isBool(v), let n = v as? NSNumber, let d = Double(exactly: n.doubleValue), d.isFinite,
+              d == d.rounded(), abs(d) < 1e9 else { return nil }
+        return Int(d)
+    }
+
+    static func number(_ v: Any?, in range: ClosedRange<Double>) -> Double? {
+        guard !isBool(v), let n = v as? NSNumber else { return nil }
+        let d = n.doubleValue
+        guard d.isFinite else { return nil }
+        return min(max(d, range.lowerBound), range.upperBound)
+    }
+}
+
+/// Cuts the port's bytes into lines: at most 4 KB each (a longer one is
+/// dropped up to its newline), at most 20 a second (more are dropped).
+public struct MediaLines {
+    private var buffer = [UInt8]()
+    private var skipping = false
+    private var second = -Double.infinity
+    private var inSecond = 0
+    public private(set) var droppedLong = 0
+    public private(set) var droppedFast = 0
+
+    public init() {}
+
+    public mutating func feed<C: Collection>(_ bytes: C, now: Double) -> [Data] where C.Element == UInt8 {
+        var lines: [Data] = []
+        for b in bytes {
+            if b == 0x0A {
+                if skipping {
+                    skipping = false
+                } else if take(now: now) {
+                    lines.append(Data(buffer))
+                }
+                buffer.removeAll(keepingCapacity: true)
+                continue
+            }
+            guard !skipping else { continue }
+            if buffer.count == MediaLimits.lineBytes {
+                buffer.removeAll(keepingCapacity: true)
+                skipping = true
+                droppedLong += 1
+                continue
+            }
+            buffer.append(b)
+        }
+        return lines
+    }
+
+    private mutating func take(now: Double) -> Bool {
+        if now - second >= 1 { second = now; inSecond = 0 }
+        guard inSecond < MediaLimits.linesPerSecond else { droppedFast += 1; return false }
+        inSecond += 1
+        return true
+    }
+}
diff --git a/host/launcher/Sources/steamac-vm/OmacVM.swift b/host/launcher/Sources/steamac-vm/OmacVM.swift
new file mode 100644
index 0000000..2067a79
--- /dev/null
+++ b/host/launcher/Sources/steamac-vm/OmacVM.swift
@@ -0,0 +1,458 @@
+// OmacVM.app's Mac-side features for the guest's org.omacvm.* agents (nixos-gpu-vm): the Mac's
+// battery, AirPods and media controls, the camera and Touch ID. Ported from OmacVM
+// (github.com/gillesgoetsch/omacvm), MIT, (c) 2026 Gilles Goetsch: NativeBatteryBridge.swift,
+// NativeMediaBridge.swift, NowPlaying.swift and the Runner's wiring. The line protocols are
+// omacvm's, byte for byte; what differs is the transport: a virtio-console port of libkrun
+// instead of QEMU's chardev socket, so there is exactly one connection per launcher run and no
+// reconnect.
+import Darwin
+import Foundation
+import IOKit.ps
+import MediaPlayer
+
+/// One org.omacvm.* virtio-console port. One end of a Unix socketpair goes to libkrun as the
+/// port's input and output (it dups both); the launcher reads and writes the other end, `fd`, as
+/// omacvm's bridges did QEMU's socket. Data the guest has not opened the port for waits in the
+/// socket (libkrun stops taking it once the guest's queue is full).
+final class OmacPort {
+    let name: String
+    /// Ours.
+    let fd: Int32
+    /// Handed to libkrun as input and output.
+    let guestFd: Int32
+
+    init(_ name: String) throws {
+        var p: [Int32] = [0, 0]
+        guard socketpair(AF_UNIX, SOCK_STREAM, 0, &p) == 0 else {
+            throw OptionError("socketpair(\(name)): \(String(cString: strerror(errno)))")
+        }
+        for f in p {
+            _ = fcntl(f, F_SETFD, FD_CLOEXEC)
+            var one: Int32 = 1
+            setsockopt(f, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout<Int32>.size))
+        }
+        self.name = name
+        fd = p[0]
+        guestFd = p[1]
+    }
+
+    /// Every byte, blocking; false when the socket failed.
+    @discardableResult
+    func writeAll(_ data: Data) -> Bool {
+        data.withUnsafeBytes { b in
+            var off = 0
+            while off < b.count {
+                let n = Darwin.write(fd, b.baseAddress! + off, b.count - off)
+                if n > 0 { off += n } else if n < 0 && errno == EINTR { continue } else { return false }
+            }
+            return true
+        }
+    }
+}
+
+/// The ports this run gives the guest (Options: each one can be switched off) and their Mac sides.
+final class OmacVMBridges {
+    let ports: [OmacPort]
+    private let battery: OmacBatteryBridge?
+    private let media: OmacMediaBridge?
+    private let camera: OmacPort?
+    private let auth: AuthRelay?
+    private let cameraHub: CameraHub?
+    /// Touch ID's VM name for the Bridge: its key is vm-keys/<sha256("app/" + name)[:32]>.touchid
+    /// in ~/Library/Application Support/omacvm (modules/features/omacvm-bridge).
+    static let vmName = "nixos-gpu-vm"
+
+    init(options o: Options) throws {
+        var ports: [OmacPort] = []
+        func port(_ on: Bool, _ name: String) throws -> OmacPort? {
+            guard on else { return nil }
+            let p = try OmacPort(name)
+            ports.append(p)
+            return p
+        }
+        battery = try port(o.omacBattery, "org.omacvm.battery").map(OmacBatteryBridge.init)
+        media = try port(o.omacMedia, MediaPort.name).map(OmacMediaBridge.init)
+        camera = try port(o.omacCamera, "org.omacvm.camera")
+        cameraHub = camera.map { _ in CameraHub { log("camera: \($0)") } }
+        auth = try port(o.touchID, "org.omacvm.auth").map { p in
+            AuthRelay(guest: p.fd, connectBridge: { AuthRelay.connectBridge() },
+                      headers: { AuthRelay.relayHeaders(vmName: OmacVMBridges.vmName) },
+                      log: { log("touch id: \($0)") })
+        }
+        self.ports = ports
+        log("omacvm: ports " + (ports.isEmpty ? "none" : ports.map(\.name).joined(separator: ", ")))
+    }
+
+    /// After the VM is configured (ports attached); main thread.
+    func start() {
+        battery?.start()
+        media?.start()
+        if let camera, let cameraHub {
+            Thread.detachNewThread { cameraHub.run(fd: camera.fd, label: "guest") }
+        }
+        if let auth {
+            Thread.detachNewThread {
+                do { try auth.run() } catch { log("touch id: \(error.localizedDescription)") }
+            }
+        }
+    }
+
+    /// The VM sleeps (SuspendController) or wakes: media controls follow (MediaClaim).
+    func vmPaused(_ paused: Bool) { media?.vmPaused(paused) }
+}
