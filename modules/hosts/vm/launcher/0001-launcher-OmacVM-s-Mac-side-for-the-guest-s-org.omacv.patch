+// MARK: Battery (NativeBatteryBridge)
+
+/// The Mac's battery to the guest's omacvm-battery over org.omacvm.battery: one JSON snapshot per
+/// line (OmacHostBattery.swift) on every change of the Mac's power sources and every 30 seconds,
+/// only after the agent asked once ({"type":"refresh"}). Any other line is ignored.
+final class OmacBatteryBridge: @unchecked Sendable {
+    static let heartbeatSeconds = 30.0
+    static let maximumLineBytes = 4096
+
+    private let port: OmacPort
+    private let stateQueue = DispatchQueue(label: "org.omacvm.battery-bridge")
+    private var lastSent: HostBatterySnapshot?
+    private var guestListening = false
+    private var heartbeat: DispatchSourceTimer?
+    private var failed = false
+
+    init(port: OmacPort) { self.port = port }
+
+    static func isRefreshRequest(_ line: Data) -> Bool {
+        (try? JSONSerialization.jsonObject(with: line) as? [String: Any])?["type"] as? String == "refresh"
+    }
+
+    func start() {
+        // IOKit's power notifications on the main run loop (the read loop has its own thread).
+        let context = Unmanaged.passUnretained(self).toOpaque()
+        if let source = IOPSNotificationCreateRunLoopSource({ context in
+            guard let context else { return }
+            Unmanaged<OmacBatteryBridge>.fromOpaque(context).takeUnretainedValue().send(forced: false)
+        }, context)?.takeRetainedValue() {
+            CFRunLoopAddSource(CFRunLoopGetMain(), source, .commonModes)
+        } else {
+            log("battery: no IOKit power notifications; every 30 s only")
+        }
+        let timer = DispatchSource.makeTimerSource(queue: stateQueue)
+        timer.schedule(deadline: .now() + Self.heartbeatSeconds, repeating: Self.heartbeatSeconds, leeway: .seconds(1))
+        timer.setEventHandler { [weak self] in self?.sendOnQueue(forced: true) }
+        timer.resume()
+        heartbeat = timer
+        let t = Thread { [self] in readLoop() }
+        t.name = "org.omacvm.battery"
+        t.start()
+    }
+
+    private func readLoop() {
+        var line = Data(), skipping = false
+        var chunk = [UInt8](repeating: 0, count: 4096)
+        while true {
+            let count = chunk.withUnsafeMutableBytes { Darwin.read(port.fd, $0.baseAddress, $0.count) }
+            if count < 0 && errno == EINTR { continue }
+            guard count > 0 else { return }
+            var start = 0
+            for index in 0..<count where chunk[index] == 0x0A {
+                if !skipping {
+                    line.append(contentsOf: chunk[start..<index])
+                    // In step with the write, so a guest that floods requests waits for its answers.
+                    if Self.isRefreshRequest(line) {
+                        stateQueue.sync { guestListening = true; sendOnQueue(forced: true) }
+                    }
+                }
+                line.removeAll(keepingCapacity: true)
+                skipping = false
+                start = index + 1
+            }
+            if !skipping {
+                line.append(contentsOf: chunk[start..<count])
+                if line.count > Self.maximumLineBytes { line.removeAll(); skipping = true }
+            }
+        }
+    }
+
+    private func send(forced: Bool) {
+        stateQueue.async { [weak self] in self?.sendOnQueue(forced: forced) }
+    }
+
+    /// Only on stateQueue. Unchanged snapshots go only when forced.
+    private func sendOnQueue(forced: Bool) {
+        guard guestListening, !failed else { return }
+        let snapshot = HostBatterySnapshot.capture()
+        guard forced || snapshot != lastSent else { return }
+        if port.writeAll(snapshot.line) {
+            lastSent = snapshot
+        } else {
+            failed = true
+            log("battery: cannot write the guest's port: \(String(cString: strerror(errno)))")
+        }
+    }
+}
+
+// MARK: AirPods and media controls (NativeMediaBridge, MediaSession, NowPlaying)
+
+/// The launcher's end of org.omacvm.media: reads the guest's lines on a thread (MediaLines: 4 KB,
+/// 20 a second) and hands each message to the main thread, which owns the rest. Writes never
+/// block (MSG_DONTWAIT): a full port drops the line, and the rest of a part-sent line goes out
+/// first, with the next line or the session's retry a second later.
+final class OmacMediaBridge: @unchecked Sendable {
+    private let port: OmacPort
+    private var pending = Data()     // main thread
+    private var session: MediaSession?
+
+    init(port: OmacPort) { self.port = port }
+
+    func start() {
+        let s = MainActor.assumeIsolated { MediaSession(on: true, bridge: self) }
+        session = s
+        let t = Thread { [self] in
+            var lines = MediaLines()
+            var chunk = [UInt8](repeating: 0, count: 4096)
+            var long = 0, fast = 0
+            while true {
+                let n = chunk.withUnsafeMutableBytes { Darwin.read(port.fd, $0.baseAddress, $0.count) }
+                if n < 0, errno == EINTR { continue }
+                guard n > 0 else { return }
+                let now = ProcessInfo.processInfo.systemUptime
+                for line in lines.feed(chunk[0..<n], now: now) {
+                    guard let m = MediaLine.parse(line) else { continue }
+                    DispatchQueue.main.async { MainActor.assumeIsolated { s.received(m) } }
+                }
+                if lines.droppedLong != long || lines.droppedFast != fast {
+                    let why = lines.droppedLong != long ? "over 4 KB" : "over 20 a second"
+                    long = lines.droppedLong; fast = lines.droppedFast
+                    DispatchQueue.main.async { MainActor.assumeIsolated { s.dropped(why) } }
+                }
+            }
+        }
+        t.name = "org.omacvm.media"
+        t.start()
+    }
+
+    func vmPaused(_ paused: Bool) {
+        guard let s = session else { return }
+        MainActor.assumeIsolated { paused ? s.sleep() : s.wake() }
+    }
+
+    @MainActor var hasPending: Bool { !pending.isEmpty }
+
+    /// The rest of a part-sent line, without waiting: true when nothing is left.
+    @MainActor func flush() -> Bool {
+        if !pending.isEmpty {
+            let n = send(pending)
+            pending.removeFirst(max(0, n))
+        }
+        return pending.isEmpty
+    }
+
+    /// One line to the guest, without waiting: false when the port did not take it.
+    @MainActor func write(_ line: Data) -> Bool {
+        guard flush() else { return false }
+        let n = send(line)
+        if n <= 0 { return false }
+        if n < line.count { pending = line.subdata(in: n..<line.count) }
+        return true
+    }
+
+    @MainActor private func send(_ d: Data) -> Int {
+        d.withUnsafeBytes { b in
+            while true {
+                let n = Darwin.send(port.fd, b.baseAddress, b.count, MSG_DONTWAIT)
+                if n < 0, errno == EINTR { continue }
+                return n
+            }
+        }
+    }
+}
+
+/// omacvm's MediaSession (NowPlaying.swift) on one port that never closes: while the guest
+/// plays, this process is the Mac's Now Playing app, so AirPods, Control Center and the play keys
+/// reach the guest's player. MediaClaim owns the rules, with the uptime as its clock. The switch
+/// is the launcher option (--no-omacvm-media leaves the port out instead), so it never changes.
+@MainActor
+final class MediaSession {
+    private var claim: MediaClaim
+    private let bridge: OmacMediaBridge
+    private var timer: Timer?
+    private var retry: Timer?
+    private var unsent: Data?
+    private var lastDropLog = -Double.infinity
+    private var stopped = false
+
+    static var now: Double { ProcessInfo.processInfo.systemUptime }
+
+    init(on: Bool, bridge: OmacMediaBridge) {
+        self.bridge = bridge
+        claim = MediaClaim(on: on)
+        claim.connected()
+    }
+
+    func received(_ m: GuestMessage) {
+        guard !stopped else { return }
+        run(claim.received(m, now: Self.now))
+    }
+
+    func dropped(_ why: String) {
+        let now = Self.now
+        guard now - lastDropLog >= 60 else { return }
+        lastDropLog = now
+        log("media controls: lines from the guest dropped (\(why))")
+    }
+
+    func sleep() { claim.sleep(); schedule() }
+    func wake() { run(claim.wake(now: Self.now)) }
+
+    func stop(_ why: String) {
+        guard !stopped else { return }
+        run(claim.stop(why))
+        stopped = true
+        timer?.invalidate()
+        timer = nil
+        retry?.invalidate()
+        retry = nil
+        NowPlaying.shared.release(for: self)
+    }
+
+    private func run(_ fx: [MediaClaim.Effect]) {
+        for e in fx {
+            switch e {
+            case .send(let line): unsent = bridge.write(line) ? nil : line
+            case .log(let line): log("media controls: \(line)")
+            }
+        }
+        retryLater()
+        apply()
+    }
+
+    private func retryLater() {
+        guard retry == nil, bridge.hasPending || unsent != nil else { return }
+        let t = Timer(timeInterval: 1, repeats: false) { [weak self] _ in
+            MainActor.assumeIsolated {
+                guard let self else { return }
+                self.retry = nil
+                guard !self.stopped else { return }
+                if let line = self.unsent {
+                    if self.bridge.write(line) { self.unsent = nil }
+                } else {
+                    _ = self.bridge.flush()
+                }
+                self.retryLater()
+            }
+        }
+        RunLoop.main.add(t, forMode: .common)
+        retry = t
+    }
+
+    private func apply() {
+        guard !stopped else { return }
+        NowPlaying.shared.show(claim.shown, for: self)
+        schedule()
+    }
+
+    private func schedule() {
+        timer?.invalidate()
+        timer = nil
+        guard let at = claim.deadline else { return }
+        let t = Timer(timeInterval: max(0.05, at - Self.now), repeats: false) { [weak self] _ in
+            MainActor.assumeIsolated {
+                guard let self, !self.stopped else { return }
+                self.run(self.claim.tick(now: Self.now))
+            }
+        }
+        RunLoop.main.add(t, forMode: .common)
+        timer = t
+    }
+
+    func command(_ c: RemoteCommand) -> MPRemoteCommandHandlerStatus {
+        switch claim.command(c, now: Self.now) {
+        case .notClaimed:
+            return .noActionableNowPlayingItem
+        case .noLink:
+            log("media controls: \(c.rawValue) from macOS: not sent (the guest's agent is not connected)")
+            return .commandFailed
+        case .send(let m):
+            guard bridge.write(MediaLine.command(m)) else {
+                log("media controls: \(c.rawValue) from macOS: not sent (the guest's port is full)")
+                return .commandFailed
+            }
+            run(claim.commandSent(c, m, now: Self.now))
+            return .success
+        }
+    }
+}
+
+/// The process's Now Playing registration (omacvm's NowPlaying, unchanged but for the names).
+@MainActor
+final class NowPlaying {
+    static let shared = NowPlaying()
+    private weak var owner: MediaSession?
+    private var registered = false
+    private var infoGate = MediaClaim.InfoGate()
+
+    private var commands: [(MPRemoteCommand, RemoteCommand)] {
+        let c = MPRemoteCommandCenter.shared()
+        return [(c.playCommand, .play), (c.pauseCommand, .pause), (c.togglePlayPauseCommand, .togglePlayPause),
+                (c.stopCommand, .stop), (c.nextTrackCommand, .nextTrack), (c.previousTrackCommand, .previousTrack)]
+    }
+
+    private var unused: [MPRemoteCommand] {
+        let c = MPRemoteCommandCenter.shared()
+        return [c.skipForwardCommand, c.skipBackwardCommand, c.seekForwardCommand, c.seekBackwardCommand,
+                c.changePlaybackPositionCommand, c.changePlaybackRateCommand, c.changeRepeatModeCommand,
+                c.changeShuffleModeCommand, c.ratingCommand, c.likeCommand, c.dislikeCommand, c.bookmarkCommand,
+                c.enableLanguageOptionCommand, c.disableLanguageOptionCommand]
+    }
+
+    func show(_ s: MediaClaim.Shown?, for session: MediaSession) {
+        guard let s else {
+            release(for: session)
+            return
+        }
+        owner = session
+        if !registered {
+            for (cmd, rc) in commands {
+                cmd.isEnabled = true
+                cmd.addTarget { _ in
+                    if Thread.isMainThread { return MainActor.assumeIsolated { NowPlaying.shared.handle(rc) } }
+                    return DispatchQueue.main.sync { MainActor.assumeIsolated { NowPlaying.shared.handle(rc) } }
+                }
+            }
+            for cmd in unused { cmd.isEnabled = false }
+            registered = true
+        }
+        let c = MPRemoteCommandCenter.shared()
+        if c.nextTrackCommand.isEnabled != s.canNext { c.nextTrackCommand.isEnabled = s.canNext }
+        if c.previousTrackCommand.isEnabled != s.canPrevious { c.previousTrackCommand.isEnabled = s.canPrevious }
+        let center = MPNowPlayingInfoCenter.default()
+        if infoGate.needsSet(s, now: MediaSession.now) {
+            var info: [String: Any] = [MPMediaItemPropertyTitle: s.title,
+                                       MPNowPlayingInfoPropertyPlaybackRate: s.rate,
+                                       MPNowPlayingInfoPropertyMediaType: MPNowPlayingInfoMediaType.audio.rawValue]
+            if !s.artist.isEmpty { info[MPMediaItemPropertyArtist] = s.artist }
+            if !s.album.isEmpty { info[MPMediaItemPropertyAlbumTitle] = s.album }
+            if let d = s.duration { info[MPMediaItemPropertyPlaybackDuration] = d }
+            if let e = s.elapsed { info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = e }
+            center.nowPlayingInfo = info
+        }
+        let state: MPNowPlayingPlaybackState = s.playing ? .playing : .paused
+        if center.playbackState != state { center.playbackState = state }
+    }
+
+    func release(for session: MediaSession) {
+        guard registered, owner == nil || owner === session else { return }
+        for (cmd, _) in commands {
+            cmd.removeTarget(nil)
+            cmd.isEnabled = false
+        }
+        let center = MPNowPlayingInfoCenter.default()
+        center.nowPlayingInfo = nil
+        center.playbackState = .stopped
+        registered = false
+        infoGate.cleared()
+        owner = nil
+    }
+
+    private func handle(_ c: RemoteCommand) -> MPRemoteCommandHandlerStatus {
+        owner?.command(c) ?? .noActionableNowPlayingItem
+    }
+}
