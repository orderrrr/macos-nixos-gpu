+    /// The two halves of the NixOS snowflake (nixos-artwork's nix-snowflake.svg, CC-BY 4.0, its
+    /// colours without the gradients): one lambda turned about the centre every 60°, the dark ones
+    /// at 0° and ±120°, the light ones at ±60° and 180°. Unit square, y up, centred on 0.5.
+    static let snowflakePaths: (light: CGPath, dark: CGPath) = {
+        // The lambda as in the SVG: its first point, then relative moves (y down there).
+        var p = CGPoint(x: 309.54892, y: -710.38827)
+        let moves: [(CGFloat, CGFloat)] = [(122.19683, 211.67512), (-56.15706, 0.5268), (-32.6236, -56.8692),
+                                           (-32.85645, 56.5653), (-27.90237, -0.011), (-14.29086, -24.6896),
+                                           (46.81047, -80.4901), (-33.22946, -57.8257)]
+        let centre = CGPoint(x: 407.3, y: -715.8), size: CGFloat = 501.56
+        let lambda = CGMutablePath()
+        lambda.move(to: CGPoint(x: p.x - centre.x, y: centre.y - p.y))
+        for (dx, dy) in moves {
+            p.x += dx; p.y += dy
+            lambda.addLine(to: CGPoint(x: p.x - centre.x, y: centre.y - p.y))
+        }
+        lambda.closeSubpath()
+        func turned(_ degrees: [CGFloat]) -> CGPath {
+            let out = CGMutablePath()
+            for d in degrees {
+                // SVG's rotate turns clockwise on screen; y is up here.
+                let t = CGAffineTransform(translationX: 0.5, y: 0.5).scaledBy(x: 1 / size, y: 1 / size).rotated(by: -d * .pi / 180)
+                out.addPath(lambda, transform: t)
+            }
+            return out
+        }
+        return (turned([60, -60, 180]), turned([0, 120, -120]))
+    }()
 
